# Apache Ranger Admin + the StarRocks lookup plugin (resource autocomplete and
# "Test Connection" for the starrocks service). Built by scripts/build-images.sh.
IMAGE=localhost:5001/ranger-admin
TAG=2.9.0-starrocks.1
BASE_IMAGE=docker.io/apache/ranger:2.9.0

# https://docs.starrocks.io/docs/administration/user_privs/authorization/ranger_plugin/
# (link on https://www.starrocks.io/download/community, "Ranger plugin"; built 2023-11-21, Java 8 bytecode)
STARROCKS_PLUGIN_URL=https://releases.starrocks.io/resources/ranger-starrocks-plugin-3.0.0-SNAPSHOT.jar
STARROCKS_PLUGIN_SHA256=d01123372b55cb435ce81dcdfc8ada262aa8075501ef3d63f0a824b4fccf84bc

# MySQL Connector/J from Maven Central (the plugin talks to the StarRocks FE over JDBC)
MYSQL_CONNECTOR_URL=https://repo1.maven.org/maven2/com/mysql/mysql-connector-j/9.3.0/mysql-connector-j-9.3.0.jar
MYSQL_CONNECTOR_SHA256=6c8e6692b521376d89bc5618c16cdeaf8c61854329f4fa25677ed08776c5bb76

DOCKERFILE=Dockerfile
