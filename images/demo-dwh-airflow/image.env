# Airflow image of the demo-dwh project (Airflow 3.4 + Cosmos + StarRocks
# client + dbt in its own virtualenv with the dbt project and its manifest).
# Built from the project's own Dockerfile (dev/airflow/Dockerfile) at a pinned
# commit. The DAGs come from git-sync at runtime; the dbt project and manifest
# come from this image, so a dbt change needs a new image (bump SOURCE_COMMIT).
SOURCE_REPO=github.com/viethqb/demo-dwh.git      # private: cloned with GITHUB_TOKEN or `gh auth token`
SOURCE_COMMIT=45cf8ed3edf0
IMAGE=localhost:5001/demo-dwh-airflow
TAG=45cf8ed3edf0
CONTEXT=src
DOCKERFILE=src/dev/airflow/Dockerfile
